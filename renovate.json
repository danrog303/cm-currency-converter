{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "packageRules": [
    {
      "description": "Bump the package version when updating its dependencies",
      "matchManagers": ["npm"],
      "matchFileNames": [
        "plasmo-extension/package.json",
        "api-lambda/get-exchange-rates/package.json"
      ],
      "bumpVersion": "patch"
    },
    {
      "description": "Give npm releases three days before merging",
      "matchDatasources": ["npm"],
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Automerge patch updates for stable npm packages",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch"],
      "matchCurrentVersion": "!/^0\\./",
      "automerge": true
    },
    {
      "description": "Automerge GitHub Actions commit SHA pinning",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["pinDigest"],
      "automerge": true
    }
  ]
}
